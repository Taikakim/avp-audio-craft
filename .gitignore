# This repo tracks ONLY the cross-project coordination docs. Everything else in
# SAO/ is either its own git repo (stable-audio-3, stable-audio-tools, torchcodec,
# sa3-rocm7.13-test) or large build artifacts (my_wheels). Use a root-anchored
# /* ignore so re-including a directory (e.g. docs/) lets git descend into it,
# while nested repos stay ignored and are never recursed into.
/*
!/.gitignore
!/README.md
!/MASTER.md
!/WORKLOG.md
!/ARCHITECTURE.md
!/CLAUDE.md
!/docs/
!/CONSTRUCTS.md
!/DISCOVERIES.md
# doc-oversight 2026-08-05: track model_index (the kept-up-to-date model roster) + the renamed
# FAQ (a Q&A archive that must survive context compaction) — both were untracked/local-only.
!/model_index.md
!/WHAT-KIM-WANTED-TO-KNOW.md
!/projects.toml
!/install.sh
!/lumi/

# checkpoint-stats is a tracked library (per MASTER §5), not throwaway output
!checkpoint-stats/

# Fleet skills: tracked so they're version-controlled + shared, and cloud Routines (which
# clone the repo) can read them. Un-ignore .claude/, re-ignore its contents (local settings
# stay out), then allowlist the whole skills/ tree. (Kim 2026-08-05: skills should be committed.)
!/.claude/
/.claude/*
!/.claude/skills/

# Master-repo tooling (copied from the forks; see docs/superpowers/plans/2026-06-29-master-repo-copy-stage.md)
!/onnx/
!/control/
!/latch/
!/eval/
!/constraints-rocm-stack.txt

# Never track Python bytecode under the now-tracked tooling dirs (smoke tests create it)
__pycache__/
*.pyc
!/profiles/
!/site/

# Paper knowledge: track the never-reinvent index + per-paper abstracts (shared
# findings, previously single-copy local); the PDFs themselves stay untracked (large),
# including the low-relevance-triage subfolder (gap found + fixed 2026-07-17: the old
# rule only matched papers/*.pdf, not subdirectories)
!/papers/
/papers/**/*.pdf

# Per-file edit locks (Misc/filelock.py) and the dialogue lock — never tracked
*.lock

# Cross-instance coordination + site tooling (the rest of Misc/ is local scratch:
# debug wavs, logs, one-off scripts). Track only the shared canonical tools.
!/Misc/
/Misc/*
!/Misc/agent_dialogue.py
!/Misc/osc_worklog.py
!/Misc/filelock.py
!/Misc/build_site.py
!/Misc/build_evals.py
!/Misc/eval_grid.py
!/Misc/build_goa_musicology_page.py
!/Misc/merge_comments.py
!/Misc/comment_targets.json
!/Misc/comment_notes_block.py
!/Misc/inject_comment_widget.py
!/Misc/build_disentangle.py
!/Misc/build_mp_crossmodel.py
!/Misc/build_e1_pilot_page.py
!/Misc/build_latch_sa3_matrix_page.py
!/Misc/build_onset_narrative_page.py
!/Misc/build_headb_bracket_page.py
!/Misc/build_xft_distillation_page.py
!/Misc/latent_dim_feature_xcorr.py
!/Misc/latent_noise_fragility.py
!/Misc/build_dms.py
!/Misc/worklog_note.sh
!/Misc/build_paper_verdicts.py
!/Misc/paper_verdicts_data.json

# DM logs (tracked — private repo, private content; NOT publicly mirrored by default)
!/*.*.log
# OSC event queue (ephemeral, not tracked)
/.osc-queue.jsonl

eval/clap_degen_model_matrix.csv
eval/clap_full_table.csv

# --- large generated artifacts / binaries — never commit (F consolidation 2026-08-04) ---
onnx/exports/
eval/musicology/
eval/clip_metrics.db
.*.log
*.npz
*.npy
*.m4a
*.wav
*.flac
*.ckpt
*.safetensors
*.pt
*.pth
*.onnx
*.pkl
*.db

# model_index generator + its legacy snapshot (doc-oversight 2026-08-05)
!/Misc/build_model_index_page.py
!/Misc/model_index_legacy.md
